# Database
DB_URL=jdbc:postgresql://localhost:5432/sphere_users
DB_USERNAME=postgres
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRE_SECONDS=604800

# Frontend
CLIENT_URL=http://localhost:5173

# Email (SMTP — matches source's active Nodemailer path)
FROM_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_MAIL=
SMTP_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Service discovery
EUREKA_URI=http://localhost:8761/eureka/

# NOTE: no TWILIO_* variables — phone verification is excluded.
# See docs/exclusions/TWILIO_EXCLUDED.md
