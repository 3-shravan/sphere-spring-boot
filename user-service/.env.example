# Server
USER_SERVICE_PORT=8081

# Database
DB_URL=jdbc:postgresql://localhost:5432/sphere_users
DB_USERNAME=postgres
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRE_SECONDS=604800

# Internal service-to-service auth (MUST match other services' INTERNAL_API_SECRET)
